FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvConstraints;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

core
{
    type            krakenFixedTemperatureConstraint;
    libs            ("libkrakenIO.so");

    cellZone        all;

    inputPhase      solid;
    outputPhases    (gas liquid);

    points
    (
        #include "${FOAM_CASE}/all_cell_centres"
    );
}

