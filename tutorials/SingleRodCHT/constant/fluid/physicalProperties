thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState rPolynomial;
    specie          specie;
    energy          sensibleEnthalpy;
}


// Water
mixture
{
    specie
    {
        molWeight       18.0153;
    }

    equationOfState
    {
        C (0.001278 -2.1055e-06 3.9689e-09 4.3772e-13 -2.0225e-16);
    }

    thermodynamics
    {
        hf          0;
        Cp          4184;
    }

    transport
    {
        mu          1e-3;
        kappa       0.6;
    }
}


