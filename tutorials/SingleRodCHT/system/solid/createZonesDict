FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      createZonesDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fuel
{
    type        cylinder;
    zoneType    cell;
    point1      (0 0 -99);
    point2      (0 0  99);
    radius      0.0095;
}

cladding
{
    type        invert;

    fuel;
}


