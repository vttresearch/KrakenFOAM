FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs
();

regionSolvers
{
    fluid       fluid;
    solid       solid;
}

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         100;

deltaT          1e-4;

writeControl    adjustableRunTime;

writeInterval   1;

purgeWrite      2;

writeFormat     binary;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

adjustTimeStep  no;

maxCo           1.0;

maxDeltaT       1e-1;


