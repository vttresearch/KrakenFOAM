liquidEnthalpyIn
{
    type            surfaceFieldValue;
    functionObjectLibs ( "libfieldFunctionObjects.so" );
    log             no;
    writeFields     false;
    patch           inlet;
    operation       sum;
    weightField     alphaRhoPhi.liquid;
    fields          ( h.liquid );
}

