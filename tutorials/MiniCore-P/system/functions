FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      functions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


#includeFunc cellMaxMag
(
    name=cellMaxMag,
    log=yes,
    U.gas, U.liquid, p, alpha.gas, T.gas, T.solid, T.liquid
)

#includeFunc cellMinMag
(
    name=cellMinMag,
    log=yes,
    U.gas, U.liquid, p, alpha.gas, T.gas, T.solid, T.liquid
)

integrals
{
    type            volFieldValue;
    functionObjectLibs ("libfieldFunctionObjects.so");
    log             no;
    write           yes;
    writeFields     no;
    cellZone        all;
    operation       volIntegrate;
    fields
    (
        heatTransferLimitedPhaseChange:mDot
        solidSurfaceBoiling:mDot
    );
}

inletLiquidMassFlow
{
    type            surfaceFieldValue;
    functionObjectLibs ("libfieldFunctionObjects.so");
    log             no;
    writeFields     false;
    patch           inlet;
    operation       sum;
    fields
    (
        alphaRhoPhi.liquid
    );
}

outletLiquidMassFlow
{
    type            surfaceFieldValue;
    functionObjectLibs ("libfieldFunctionObjects.so");
    log             no;
    writeFields     false;
    patch           outlet;
    operation       sum;
    fields
    (
        alphaRhoPhi.liquid
    );
}

